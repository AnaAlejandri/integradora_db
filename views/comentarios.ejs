<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Comentarios</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 24px 16px;
      font-family: Arial, Helvetica, sans-serif;
      background-color: #f6f7fb;
      color: #222;
    }

    main {
      max-width: 820px;
      margin: 0 auto;
      background: #ffffff;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }

    h1, h2 {
      margin-top: 0;
      color: #1f2937;
    }

    a {
      display: inline-block;
      margin-bottom: 16px;
      color: #2563eb;
      text-decoration: none;
      font-weight: bold;
    }

    a:hover {
      text-decoration: underline;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 28px;
    }

    label {
      font-weight: bold;
      font-size: 14px;
    }

    input, textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 15px;
      font-family: inherit;
    }

    textarea {
      min-height: 90px;
      resize: vertical;
    }

    button {
      align-self: flex-start;
      padding: 10px 18px;
      background-color: #2563eb;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background-color: #1d4ed8;
    }

    .tabla-contenedor {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }

    th, td {
      padding: 12px;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
      vertical-align: top;
    }

    th {
      background-color: #eff6ff;
      color: #1e3a8a;
      font-size: 14px;
    }

    tr:hover td {
      background-color: #f9fafb;
    }

    @media (max-width: 600px) {
      main {
        padding: 16px;
      }

      button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main>
    <h1>Comentarios / Opiniones</h1>
    <a href="/">Volver al inicio</a>

    <% if (typeof avisoDB !== 'undefined' && avisoDB) { %>
      <p><%= avisoDB %></p>
    <% } %>

    <form action="/comentarios" method="POST">
      <label for="nombre">Nombre:</label>
      <input id="nombre" name="nombre" type="text" required />

      <label for="comentario">Comentario:</label>
      <textarea id="comentario" name="comentario" required></textarea>

      <button type="submit">Publicar</button>
    </form>

    <section>
      <h2>Opiniones guardadas</h2>
      <% const lista = typeof opiniones !== 'undefined' ? opiniones : []; %>
      <% if (lista.length === 0) { %>
        <p>Todavía no hay comentarios.</p>
      <% } else { %>
        <div class="tabla-contenedor">
          <table>
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Comentario</th>
              </tr>
            </thead>
            <tbody>
              <% lista.forEach((item) => { %>
                <tr>
                  <td><strong><%= item.nombre %></strong></td>
                  <td><%= item.comentario %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
